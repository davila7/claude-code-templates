---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import SearchModal from '../../../components/SearchModal.tsx';
import CartSidebar from '../../../components/CartSidebar.tsx';
import SaveToCollectionButton from '../../../components/SaveToCollectionButton.tsx';
import MarkdownViewer from '../../../components/MarkdownViewer.tsx';
import JsonViewer from '../../../components/JsonViewer.tsx';
import SkillExplorer from '../../../components/SkillExplorer.tsx';
import AddToStackButton from '../../../components/AddToStackButton.tsx';
import SkillSpectorReport from '../../../components/SkillSpectorReport.tsx';
import { TYPE_CONFIG, ICONS } from '../../../lib/icons';
import { fetchComponents, fetchComponentContentData, getInstallCommand } from '../../../lib/data';
import type { ComponentPageMeta } from '../../../lib/data';
import { commitTitle, formatBytes, formatCount, formatDate, initials, languageShares, topLevelEntries, totals } from '../../../lib/component-page';
import type { Component } from '../../../lib/types';
import { jsonForScript } from '../../../lib/sanitize-html';

export const prerender = false;

const { type, slug } = Astro.params;

let component: Component | null = null;
let error: string | null = null;
// Mods (function hooks): a complete plugin directory; the
// content file carries README.md as content plus every text file of it.
let modFiles: Record<string, string> = {};
// Files, languages and git history for the file list and the About column.
let pageMeta: ComponentPageMeta | null = null;

try {
  const data = await fetchComponents();
  const typeKey = (type?.endsWith('s') ? type : (type + 's')) as keyof typeof data;
  const items = data[typeKey] as Component[] | undefined;

  if (items) {
    component = items.find((c) => {
      const cleanPath = c.path?.replace(/\.(md|json)$/, '') ?? '';
      return cleanPath === slug || c.name === slug;
    }) ?? null;
  }

  // Load full content on demand — the index (components.json) no longer
  // embeds 'content' to keep the payload small (~85% reduction).
  if (component) {
    const cleanSlug = component.path?.replace(/\.(md|json)$/, '') ?? component.name;
    const contentData = await fetchComponentContentData(component.type, cleanSlug);
    component = { ...component, content: contentData.content };
    modFiles = contentData.files ?? {};
    pageMeta = contentData.meta ?? null;
  }
} catch (e: any) {
  error = e.message;
}

// A missing component is a real 404 (agents and crawlers otherwise treat every
// slug as an existing page). The "Component not found" view below still renders.
if (!component && !error) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

function formatName(name: string): string {
  if (!name) return '';
  return name.replace(/\.(md|json)$/, '').replace(/[-_]/g, ' ')
    .split(' ').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

function parseFrontmatter(content: string, componentType: string): Record<string, string> {
  if (!content) return {};

  // JSON-based components (MCPs, Settings, Hooks)
  if (componentType === 'mcps' || componentType === 'settings' || componentType === 'hooks') {
    try {
      const json = JSON.parse(content);
      const fields: Record<string, string> = {};

      // MCP: extract from mcpServers object
      if (componentType === 'mcps') {
        const servers = json.mcpServers ?? json;
        const serverName = Object.keys(servers)[0];
        if (!serverName) return {};
        const server = servers[serverName];
        if (server.description) fields['description'] = server.description;
        if (server.command) fields['command'] = server.command + (server.args?.length ? ' ' + server.args.join(' ') : '');
        if (serverName) fields['server-name'] = serverName;
        return fields;
      }

      // Settings / Hooks: top-level description
      if (json.description) fields['description'] = json.description;
      return fields;
    } catch { return {}; }
  }

  // YAML frontmatter for md files
  const match = content.match(/^---\s*\n([\s\S]*?)\n---/);
  if (!match) return {};
  const fields: Record<string, string> = {};
  let currentKey = '';
  let currentValue = '';
  for (const line of match[1].split('\n')) {
    const kv = line.match(/^(\S[\w-]*)\s*:\s*(.*)/);
    if (kv) {
      if (currentKey) fields[currentKey] = currentValue.trim();
      currentKey = kv[1];
      currentValue = kv[2].replace(/^["']|["']$/g, '');
    } else if (currentKey && (line.startsWith('  ') || line.startsWith('\t'))) {
      currentValue += ' ' + line.trim();
    }
  }
  if (currentKey) fields[currentKey] = currentValue.trim();
  return fields;
}

// Frontmatter shown as rows in the About column (description has its own paragraph).
const ABOUT_FIELDS: { key: string; label: string; kind?: 'chips' | 'code' }[] = [
  { key: 'model', label: 'Model' },
  { key: 'tools', label: 'Tools', kind: 'chips' },
  { key: 'allowed-tools', label: 'Allowed tools', kind: 'chips' },
  { key: 'argument-hint', label: 'Arguments', kind: 'code' },
  { key: 'interval', label: 'Interval' },
  { key: 'events', label: 'Events', kind: 'chips' },
  { key: 'module', label: 'Module', kind: 'code' },
  { key: 'stop-condition', label: 'Stops when' },
  { key: 'server-name', label: 'Server', kind: 'code' },
  { key: 'command', label: 'Runs', kind: 'code' },
  { key: 'version', label: 'Version' },
  { key: 'author', label: 'Author' },
  { key: 'license', label: 'License' },
];

const title = component ? formatName(component.name) : 'Component Not Found';
const typePlural = type?.endsWith('s') ? type : (type + 's');
const config = TYPE_CONFIG[typePlural ?? 'agents'];
const installCmd = component ? getInstallCommand(component) : '';
// Social preview rendered at build time by scripts/generate-og-images.mjs.
const ogImage = component && config
  ? encodeURI(`/og/${typePlural}/${component.path?.replace(/\.(md|json)$/, '') ?? component.name}.png`)
  : undefined;
const frontmatter = component ? parseFrontmatter(component.content, typePlural ?? '') : {};
// Agent Skills keep author/version/tags/license under `metadata:`, which the
// line parser above does not read; fall back to what the catalog generator parsed.
if (component) {
  for (const key of ['author', 'version', 'license'] as const) {
    if (!frontmatter[key] && component[key]) frontmatter[key] = component[key]!;
  }
  if (!frontmatter.tags && component.keywords?.length) frontmatter.tags = component.keywords.join(', ');
}
const hasValue = (v?: string) => !!v && v !== '[]' && v !== '""' && v !== "''";
const chipList = (v: string) => v.replace(/^\[|\]$/g, '').split(/,\s*/).map((x) => x.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
const aboutRows = ABOUT_FIELDS.filter((f) => hasValue(frontmatter[f.key]));
const topics = hasValue(frontmatter.tags) ? chipList(frontmatter.tags) : [];

// Loops reference other components via the frontmatter `components` field,
// encoded as a flat list of `type:path` tokens, e.g.
//   components: [agent:documentation/docs-architect, skill:git/create-pr]
// Parse them into clickable cards shown on the loop detail page.
interface ReferencedComponent {
  type: string;        // singular, e.g. "agent"
  typePlural: string;  // e.g. "agents"
  path: string;        // e.g. "documentation/docs-architect"
  name: string;        // last path segment
  label: string;       // TYPE_CONFIG label
  color: string;
  icon: string;
  href: string;
}
const referencedComponents: ReferencedComponent[] = [];
if (typePlural === 'loops' && frontmatter.components) {
  const raw = frontmatter.components.replace(/^\[|\]$/g, '');
  for (const token of raw.split(',')) {
    const trimmed = token.trim().replace(/^["']|["']$/g, '');
    if (!trimmed) continue;
    const sep = trimmed.indexOf(':');
    if (sep === -1) continue;
    const refType = trimmed.slice(0, sep).trim();
    const refPath = trimmed.slice(sep + 1).trim().replace(/\.(md|json)$/, '');
    if (!refType || !refPath) continue;
    const refTypePlural = refType.endsWith('s') ? refType : refType + 's';
    const cfg = TYPE_CONFIG[refTypePlural];
    referencedComponents.push({
      type: refType,
      typePlural: refTypePlural,
      path: refPath,
      name: refPath.split('/').pop() ?? refPath,
      label: cfg?.label ?? refType,
      color: cfg?.color ?? '#5e6ad2',
      icon: ICONS[refTypePlural] ?? '',
      href: `/component/${refTypePlural}/${refPath}`,
    });
  }
}

// External skills (source.json): code fetched from the author's repo at a pinned commit.
const externalSource = typePlural === 'skills' ? component?.source ?? null : null;
// Skills an external skill calls are installed with it, like a loop's components.
if (externalSource?.requires?.length) {
  const cfg = TYPE_CONFIG['skills'];
  for (const refPath of externalSource.requires) {
    referencedComponents.push({
      type: 'skill',
      typePlural: 'skills',
      path: refPath,
      name: refPath.split('/').pop() ?? refPath,
      label: cfg?.label ?? 'skill',
      color: cfg?.color ?? '#5e6ad2',
      icon: ICONS['skills'] ?? '',
      href: `/component/skills/${refPath}`,
    });
  }
}

// JSON-based types use JsonViewer instead of MarkdownViewer
const isJsonType = typePlural === 'settings' || typePlural === 'hooks' || typePlural === 'mcps';

// Mods: plugin metadata shown in the sidebar (modules hooked, options declared).
const modModules: string[] = typePlural === 'mods' ? ((component as any)?.modules ?? []) : [];
const modOptions: string[] = typePlural === 'mods' ? Object.keys((component as any)?.userConfig ?? {}) : [];

// Extract headings from markdown content for TOC
const contentHeadings: { level: number; text: string; id: string }[] = [];
if (component?.content && !isJsonType) {
  const stripped = component.content.replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, '');
  const headingRegex = /^(#{1,4})\s+(.+)$/gm;
  let m;
  while ((m = headingRegex.exec(stripped)) !== null) {
    const text = m[2].replace(/[*_`\[\]]/g, '').trim();
    const id = text.toLowerCase().replace(/[^\w]+/g, '-').replace(/^-|-$/g, '');
    contentHeadings.push({ level: m[1].length, text, id });
  }
}

// Reference files for skills (used for layout decisions)
// Cast to any to access references which may not be in the TS type yet
const refs: string[] = (component as any)?.references ?? [];

// GitHub-style page data. pageMeta is missing until the catalog is regenerated
// with this generator, so every block below degrades to what the index has.
const slugName = component?.name?.replace(/\.(md|json)$/, '') ?? '';
const metaFiles = pageMeta?.files ?? [];
const fileTotals = totals(metaFiles);
const fileEntries = topLevelEntries(metaFiles);
const langShares = languageShares(pageMeta?.languages ?? []);
const lastCommit = pageMeta?.lastCommit;
// The explorer (Files tab) exists for multi-file components; single files show in Overview only.
const hasExplorer = refs.length > 0;
const REPO_URL = 'https://github.com/davila7/claude-code-templates';
const sourceUrl = externalSource ? externalSource.url : component ? `${REPO_URL}/${hasExplorer ? 'tree' : 'blob'}/main/cli-tool/components/${typePlural}/${component.path}` : '';
// Where the CLI writes it (cli-tool/src/index.js); other types show no line.
const INSTALL_TARGET: Record<string, string> = {
  agents: `.claude/agents/${slugName}.md`,
  commands: `.claude/commands/${slugName}.md`,
  loops: `.claude/loops/${slugName}.md`,
  skills: `.claude/skills/${slugName}/`,
  mods: `.claude/skills/${slugName}/`,
};
const targetDir = INSTALL_TARGET[typePlural ?? ''];
const installTarget = typePlural === 'mcps'
  ? 'Merges into .mcp.json'
  : typePlural === 'hooks' || typePlural === 'settings'
    ? 'Merges into the settings file you pick'
    : targetDir
      ? (targetDir.endsWith('/') && fileTotals.files > 0 ? `Writes ${formatCount(fileTotals.files, 'file', 'files')} to ${targetDir}` : `Writes ${targetDir}`)
      : '';
// The command wraps only between its words (each word breaks inside only when it is wider than the box).
const cmdParts = installCmd.split(' ');
// Agent descriptions often carry escaped newlines and <example> tags from their frontmatter.
const aboutDescription = (frontmatter.description ?? '').replace(/\\n/g, ' ').replace(/<\/?[a-z]+>/gi, ' ').replace(/\s+/g, ' ').trim();
const fileOpen = (file: string) => (hasExplorer ? file : '');
const typeLabel = typePlural === 'mcps' ? 'MCP' : (config?.singular ?? typePlural ?? '').replace(/^./, (c) => c.toUpperCase());

const seoDescription = frontmatter.description
  ? frontmatter.description.slice(0, 155)
  : `${title} is a ${config?.label?.toLowerCase() ?? 'component'} for Claude Code. Install with a single npx command.`;

const canonicalPath = `/component/${typePlural}/${component?.path?.replace(/\.(md|json)$/, '') ?? ''}`;

const componentSchema = component
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'SoftwareApplication',
          name: title,
          description: seoDescription,
          url: `https://www.aitmpl.com${canonicalPath}`,
          applicationCategory: 'DeveloperApplication',
          operatingSystem: 'Windows, macOS, Linux',
          softwareRequirements: 'Node.js 18+, Claude Code CLI',
          installUrl: 'https://www.npmjs.com/package/claude-code-templates',
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          author: { '@id': 'https://www.aitmpl.com/#organization' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.aitmpl.com/' },
            {
              '@type': 'ListItem',
              position: 2,
              name: config?.label ?? typePlural,
              item: `https://www.aitmpl.com/${typePlural}`,
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: title,
              item: `https://www.aitmpl.com${canonicalPath}`,
            },
          ],
        },
      ],
    }
  : null;
---

<DashboardLayout
  title={`${title} — ${config?.label ?? 'Component'} for Claude Code | AI Templates`}
  description={seoDescription}
  ogImage={ogImage}
  ogImageAlt={component && config ? `${title}, a Claude Code ${config.singular}` : undefined}
>
  {componentSchema && (
    <script type="application/ld+json" set:html={jsonForScript(componentSchema)} />
  )}
  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-6 md:py-8">
    {error && (
      <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-5 mb-8">
        <p class="text-sm font-medium text-red-400 mb-1">Error loading component</p>
        <p class="text-sm text-red-400/80">{error}</p>
      </div>
    )}

    {!component && !error && (
      <div class="flex flex-col items-center justify-center py-32 px-6">
        <h3 class="text-lg font-semibold text-[var(--color-text-primary)] mb-2">Component not found</h3>
        <p class="text-[14px] text-[var(--color-text-secondary)] text-center max-w-md mb-8 leading-relaxed">
          The component you're looking for doesn't exist or may have been removed.
        </p>
        <a
          href={`/${typePlural}`}
          class="px-5 py-2.5 text-[13px] font-semibold rounded-md bg-[var(--color-accent)] text-[var(--color-surface-0)] hover:bg-[var(--color-accent-hover)] transition-colors"
        >
          Browse {config?.label}
        </a>
      </div>
    )}

    {component && (
      <article>
        {/* Header: the component as a path, like a repository name. */}
        <header class="flex flex-col gap-4 md:flex-row md:items-center">
          <nav aria-label="Breadcrumb" class="min-w-0 flex-1 flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-[17px] md:text-[20px] leading-snug">
            <a href={`/${typePlural}`} class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:underline underline-offset-4">{typePlural}</a>
            <span class="text-[var(--color-text-tertiary)]">/</span>
            {component.category && (
              <Fragment>
                <span class="text-[var(--color-text-secondary)]">{component.category}</span>
                <span class="text-[var(--color-text-tertiary)]">/</span>
              </Fragment>
            )}
            <span class="basis-full md:basis-auto flex flex-wrap items-center gap-x-2.5 gap-y-1 min-w-0">
              <h1 class="text-[26px] md:text-[20px] font-semibold tracking-tight text-[var(--color-text-primary)] break-words min-w-0">{slugName}</h1>
              <span class="inline-flex items-center rounded-full border border-[var(--color-border)] px-2.5 text-[12px] leading-[22px] font-medium text-[var(--color-text-secondary)]">{typeLabel}</span>
            </span>
          </nav>
          <div class="hidden md:flex items-center gap-2 shrink-0">
            <SaveToCollectionButton
              client:idle
              variant="button"
              componentType={component.type}
              componentPath={component.path}
              componentName={component.name}
              componentCategory={component.category ?? ''}
            />
            <AddToStackButton
              client:idle
              typePlural={typePlural ?? 'agents'}
              name={component.name}
              path={component.path}
              category={component.category ?? ''}
              description={component.description ?? ''}
            />
          </div>
        </header>

        <div class="mt-6 md:mt-0 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-x-8">
          {/* About column. On phones it comes first (install right under the name); on desktop it sits on the right. */}
          <aside class="lg:col-start-2 lg:row-start-2 lg:pt-6 flex flex-col gap-5 min-w-0">
            {aboutDescription && (
              <p class="lg:hidden text-[15px] leading-relaxed text-[var(--color-text-secondary)] line-clamp-3">{aboutDescription}</p>
            )}
            <p class="lg:hidden -mt-2 font-mono text-[12.5px] leading-relaxed text-[var(--color-text-tertiary)]">
              {(component.downloads ?? 0) > 0 && `${formatCount(component.downloads ?? 0, 'download', 'downloads')} · `}
              {metaFiles.length > 0 && `${formatCount(fileTotals.files, 'file', 'files')} · ${formatBytes(fileTotals.bytes)} · `}
              {pageMeta?.addedAt && `${formatDate(pageMeta.addedAt)} · `}
              <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] whitespace-nowrap">Source ↗</a>
            </p>

            <section aria-labelledby="install-h">
              <h2 id="install-h" class="hidden lg:block text-[14px] font-semibold text-[var(--color-text-primary)] mb-2">Install</h2>
              <div class="flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-1)] py-1.5 pl-3 pr-1.5">
                <code class="flex-1 min-w-0 font-mono text-[12px] leading-relaxed text-[var(--color-text-primary)] [overflow-wrap:anywhere]">
                  {cmdParts.map((part, i) => (
                    <Fragment>{i > 0 && ' '}<span class="inline-block max-w-full">{part}</span></Fragment>
                  ))}
                </code>
                <button
                  id="copyBtn"
                  type="button"
                  data-cmd={installCmd}
                  aria-label="Copy install command"
                  class="inline-flex items-center justify-center gap-1.5 h-11 md:h-9 min-w-[84px] lg:min-w-0 px-3 lg:px-2.5 rounded-md bg-[var(--color-accent)] text-[var(--color-surface-0)] text-[14px] md:text-[13px] font-semibold hover:bg-[var(--color-accent-hover)] transition-colors shrink-0"
                >
                  <svg data-copy-icon class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" /><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" /></svg>
                  <svg data-done-icon class="w-4 h-4" style="display:none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
                  <span class="lg:sr-only">Copy</span>
                </button>
              </div>
              {installTarget && (
                <p class="mt-2 font-mono text-[12px] text-[var(--color-text-tertiary)] break-words">{installTarget}</p>
              )}
            </section>

            <div class="grid grid-cols-2 gap-2 md:hidden">
              <SaveToCollectionButton
                client:idle
                variant="button"
                componentType={component.type}
                componentPath={component.path}
                componentName={component.name}
                componentCategory={component.category ?? ''}
              />
              <AddToStackButton
                client:idle
                typePlural={typePlural ?? 'agents'}
                name={component.name}
                path={component.path}
                category={component.category ?? ''}
                description={component.description ?? ''}
              />
            </div>

            <section aria-labelledby="about-h" class="hidden lg:block border-t border-[var(--color-border)] pt-5">
              <h2 id="about-h" class="text-[14px] font-semibold text-[var(--color-text-primary)] mb-2">About</h2>
              {aboutDescription && (
                <p class="text-[13.5px] leading-relaxed text-[var(--color-text-secondary)] mb-4 line-clamp-6" title={aboutDescription}>{aboutDescription}</p>
              )}
              <ul class="flex flex-col gap-2 text-[13.5px] text-[var(--color-text-secondary)]">
                <li>
                  {(component.downloads ?? 0) > 0
                    ? <Fragment><b class="font-medium text-[var(--color-text-primary)]">{(component.downloads ?? 0).toLocaleString('en-US')}</b> downloads</Fragment>
                    : 'No downloads yet'}
                </li>
                {metaFiles.length > 0 && (
                  <li><b class="font-medium text-[var(--color-text-primary)]">{formatCount(fileTotals.files, 'file', 'files')}</b> · {formatBytes(fileTotals.bytes)}</li>
                )}
                {pageMeta?.addedAt && (
                  <li>Added {formatDate(pageMeta.addedAt)}</li>
                )}
                <li>
                  <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline underline-offset-4">View source on GitHub</a>
                </li>
              </ul>
              {aboutRows.length > 0 && (
                <dl class="mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-[13px]">
                  {aboutRows.map((row) => (
                    <Fragment>
                      <dt class="text-[var(--color-text-tertiary)]">{row.label}</dt>
                      <dd class="min-w-0 text-[var(--color-text-primary)] break-words">
                        {row.kind === 'chips' ? (
                          <span class="flex flex-wrap gap-1">
                            {chipList(frontmatter[row.key]).map((chip) => (
                              <span class="font-mono text-[11.5px] rounded bg-[var(--color-surface-2)] px-1.5 py-0.5">{chip}</span>
                            ))}
                          </span>
                        ) : row.kind === 'code' ? (
                          <code class="font-mono text-[12px]">{frontmatter[row.key]}</code>
                        ) : frontmatter[row.key]}
                      </dd>
                    </Fragment>
                  ))}
                </dl>
              )}
              {topics.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {topics.map((t) => (
                    <span class="rounded-full bg-[var(--color-accent-light)] px-2.5 py-0.5 text-[12px] font-medium text-[var(--color-accent)]">{t}</span>
                  ))}
                </div>
              )}
            </section>

            {component.skillspector && (
              <section class="rounded-lg border border-[var(--color-border)] px-3.5 py-3 lg:rounded-none lg:border-x-0 lg:border-b-0 lg:px-0 lg:pt-5 lg:pb-0 flex items-start gap-2.5 text-[13px] text-[var(--color-text-secondary)]">
                <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
                <div>
                  <p class="font-medium text-[var(--color-text-primary)]">Scanned by NVIDIA SkillSpector</p>
                  <p>
                    {formatCount(component.skillspector.issueCount, 'observation', 'observations')}
                    {component.skillspector.scannedAt && <span class="hidden lg:inline"> · {formatDate(component.skillspector.scannedAt)}</span>}
                    {' · '}<a href="#security-scan" data-tab-link="security" class="text-[var(--color-accent)] hover:underline underline-offset-4">Read the report</a>
                  </p>
                </div>
              </section>
            )}

            {langShares.length > 0 && (
              <section aria-labelledby="lang-h" class="hidden lg:block border-t border-[var(--color-border)] pt-5">
                <h2 id="lang-h" class="text-[14px] font-semibold text-[var(--color-text-primary)] mb-2.5">Languages</h2>
                <div class="flex h-2 overflow-hidden rounded gap-0.5" aria-hidden="true">
                  {langShares.map((l, i) => (
                    <span class="block h-full" style={`width:${l.pct}%;background:${i === 0 ? 'var(--color-accent)' : `color-mix(in srgb, var(--color-text-tertiary) ${Math.max(30, 75 - i * 15)}%, transparent)`}`}></span>
                  ))}
                </div>
                <ul class="mt-2 flex flex-wrap gap-x-3.5 gap-y-1 text-[12px] text-[var(--color-text-secondary)]">
                  {langShares.map((l, i) => (
                    <li class="flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full" style={`background:${i === 0 ? 'var(--color-accent)' : `color-mix(in srgb, var(--color-text-tertiary) ${Math.max(30, 75 - i * 15)}%, transparent)`}`}></span>
                      <span class="text-[var(--color-text-primary)] font-medium">{l.name}</span> {l.pct}%
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </aside>

          {/* Tabs */}
          <div class="lg:col-span-2 lg:row-start-1 -mx-4 md:mx-0 mt-6 lg:mt-4 border-b border-[var(--color-border)] overflow-x-auto">
            <nav class="flex gap-1 px-2.5 md:px-0" role="tablist" aria-label="Component sections">
              <a href="#overview" role="tab" data-tab="overview" class="tab-link">Overview</a>
              {hasExplorer && (
                <a href="#files" role="tab" data-tab="files" class="tab-link">Files <span class="tab-count">{refs.length + 1}</span></a>
              )}
              {component.skillspector && (
                <a href="#security-scan" role="tab" data-tab="security" class="tab-link"><span>Security<span class="hidden sm:inline"> scan</span></span> <span class="tab-count">{component.skillspector.issueCount}</span></a>
              )}
            </nav>
          </div>

          <div class="lg:col-start-1 lg:row-start-2 min-w-0 pt-4 lg:pt-6 pb-8">
            {/* Overview: file list + the main file rendered, like a README. */}
            <section data-pane="overview" class="flex flex-col gap-4">
              {metaFiles.length > 0 && (
                <div class="hidden md:flex items-center gap-2">
                  <span class="font-mono text-[13px] text-[var(--color-text-secondary)]">
                    {formatCount(fileTotals.files, 'file', 'files')} · {formatCount(fileTotals.lines, 'line', 'lines')} · {formatBytes(fileTotals.bytes)}
                  </span>
                  <span class="flex-1"></span>
                  <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex h-9 items-center gap-1.5 px-3 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-1)] text-[13px] font-medium text-[var(--color-text-primary)] hover:bg-[var(--color-surface-2)] transition-colors">
                    View on GitHub
                    <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 2.5h4.5V7M13.5 2.5 7 9M12 10v3.5H2.5V4H6" /></svg>
                  </a>
                </div>
              )}

              {(metaFiles.length > 0 || lastCommit) && (
                <div class="rounded-lg border border-[var(--color-border)] overflow-hidden">
                  {lastCommit && (
                    <div class="flex items-center gap-2.5 px-4 py-2.5 bg-[var(--color-surface-1)] border-b border-[var(--color-border)] text-[13px] min-w-0">
                      <span class="w-[22px] h-[22px] rounded-full bg-[var(--color-surface-3)] grid place-items-center text-[9px] font-semibold text-[var(--color-text-secondary)] shrink-0" aria-hidden="true">{initials(lastCommit.author)}</span>
                      <span class="font-semibold text-[var(--color-text-primary)] shrink-0">{lastCommit.author}</span>
                      <span class="hidden md:block min-w-0 flex-1 truncate text-[var(--color-text-secondary)]">{commitTitle(lastCommit.subject)}</span>
                      {lastCommit.pr && (
                        <a href={`${REPO_URL}/pull/${lastCommit.pr}`} target="_blank" rel="noopener noreferrer" class="shrink-0 text-[var(--color-accent)] hover:underline underline-offset-4">#{lastCommit.pr}</a>
                      )}
                      <span class="flex-1 md:hidden"></span>
                      <a href={`${REPO_URL}/commit/${lastCommit.sha}`} target="_blank" rel="noopener noreferrer" class="shrink-0 text-[var(--color-text-tertiary)] hover:text-[var(--color-text-primary)]">
                        <span class="hidden md:inline font-mono text-[12px] mr-2">{lastCommit.sha.slice(0, 7)}</span>{formatDate(lastCommit.date)}
                      </a>
                    </div>
                  )}
                  <ul>
                    {fileEntries.map((entry) => {
                      const target = fileOpen(entry.firstFile);
                      const inner = (
                        <Fragment>
                          <span class="text-[var(--color-text-tertiary)] shrink-0" aria-hidden="true">
                            {entry.kind === 'dir' ? (
                              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" opacity=".8"><path d="M1.5 3.5a1 1 0 0 1 1-1h3.6l1.4 1.5h6a1 1 0 0 1 1 1v7.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1z" /></svg>
                            ) : (
                              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 1.5h5L12.5 5v9.5h-8.5z" /><path d="M9 1.5V5h3.5" /></svg>
                            )}
                          </span>
                          <span class="flex-1 min-w-0 truncate text-[var(--color-text-primary)]">{entry.name}</span>
                          <span class="shrink-0 font-mono text-[12px] text-[var(--color-text-tertiary)]">
                            {entry.kind === 'dir'
                              ? `${formatCount(entry.files, 'file', 'files')}${entry.lines ? ` · ${formatCount(entry.lines, 'line', 'lines')}` : ''}`
                              : `${entry.lines ? `${formatCount(entry.lines, 'line', 'lines')} · ` : ''}${formatBytes(entry.bytes)}`}
                          </span>
                        </Fragment>
                      );
                      return (
                        <li class="border-t first:border-t-0 border-[var(--color-border)]">
                          {target ? (
                            <a href="#files" data-open-file={target} class="flex items-center gap-2.5 px-4 py-3 md:py-2.5 text-[15px] md:text-[13.5px] hover:bg-[var(--color-surface-1)] transition-colors">{inner}</a>
                          ) : (
                            <div class="flex items-center gap-2.5 px-4 py-3 md:py-2.5 text-[15px] md:text-[13.5px]">{inner}</div>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}

              {externalSource && (
                <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-1)] px-4 py-2.5 text-[12px] text-[var(--color-text-secondary)]">
                  <strong class="text-[var(--color-text-primary)]">External skill.</strong> The files live in <a href={externalSource.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[var(--color-text-primary)]">{externalSource.repo}</a> and the CLI downloads them from commit <code>{externalSource.commit.slice(0, 7)}</code>, the version that was reviewed and scanned here. Newer commits reach this catalog only after a new review. License: {externalSource.license}{component?.author ? `, by ${component.author}` : ''}.
                </div>
              )}

              {typePlural === 'mods' && (
                <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-1)] px-4 py-2.5 text-[12px] text-[var(--color-text-secondary)]">
                  <strong class="text-[var(--color-text-primary)]">Claude Mod.</strong> A mod is a complete Claude Code plugin built on function hooks (Anthropic's <a href="https://github.com/anthropics/claude-code/tree/main/mods" target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--color-text-primary)]">mods/</a> layout); it is on by default in Claude Code 2.1.287+.
                  {modModules.length > 0 && (
                    <span> Hooks module{modModules.length > 1 ? 's' : ''}: {modModules.map((mod, i) => (
                      <Fragment>{i > 0 && ', '}<code>hooks/{mod}</code></Fragment>
                    ))}.</span>
                  )}
                  {modOptions.length > 0 && (
                    <span> Options: {modOptions.map((opt, i) => (
                      <Fragment>{i > 0 && ', '}<code>{opt}</code></Fragment>
                    ))} (set in user or managed settings <code>pluginConfigs</code>, or <code>/config</code>).</span>
                  )}
                  {' '}Run <code>claude plugin validate</code> on the installed folder to see every event it hooks and every <code>$</code> call it makes.
                </div>
              )}

              {referencedComponents.length > 0 && (
                <div class="rounded-lg border border-[var(--color-border)] overflow-hidden">
                  <div class="px-4 py-2.5 bg-[var(--color-surface-1)] border-b border-[var(--color-border)] text-[13px]">
                    <span class="font-semibold text-[var(--color-text-primary)]">Installs with it</span>
                    <span class="text-[var(--color-text-secondary)]"> · {referencedComponents.length} referenced components</span>
                  </div>
                  <ul>
                    {referencedComponents.map((ref) => (
                      <li class="border-t first:border-t-0 border-[var(--color-border)]">
                        <a href={ref.href} class="flex items-center gap-2.5 px-4 py-3 md:py-2.5 text-[15px] md:text-[13.5px] hover:bg-[var(--color-surface-1)] transition-colors">
                          <span class="w-20 shrink-0 text-[12px] text-[var(--color-text-tertiary)] capitalize">{ref.type}</span>
                          <span class="min-w-0 truncate text-[var(--color-text-primary)]">{ref.path}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="rounded-lg border border-[var(--color-border)] overflow-hidden">
                <div class="flex items-center gap-2.5 px-4 py-2.5 bg-[var(--color-surface-1)] border-b border-[var(--color-border)] text-[13px]">
                  <svg class="w-4 h-4 text-[var(--color-text-tertiary)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5.5 4h8M5.5 8h8M5.5 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01" /></svg>
                  <span class="font-semibold text-[var(--color-text-primary)]">{typePlural === 'mods' ? 'README.md' : typePlural === 'skills' ? 'SKILL.md' : component.path.split('/').pop()}</span>
                </div>
                <div class="p-4 md:p-6">
                  {isJsonType ? (
                    <JsonViewer client:load content={component.content || ''} />
                  ) : (
                    <MarkdownViewer client:load content={component.content || ''} headings={contentHeadings} />
                  )}
                </div>
              </div>
            </section>

            {hasExplorer && (
              <section data-pane="files" id="files" hidden>
                <SkillExplorer
                  client:load
                  skillContent={component.content || ''}
                  skillName={component.name}
                  skillPath={component.path}
                  references={refs}
                  headings={contentHeadings}
                  componentType={typePlural === 'mods' ? 'mods' : 'skills'}
                  mainFile={typePlural === 'mods' ? 'README.md' : 'SKILL.md'}
                  files={typePlural === 'mods' || externalSource ? modFiles : undefined}
                />
              </section>
            )}

            {component.skillspector && (
              <div data-pane="security" hidden>
                <SkillSpectorReport result={component.skillspector} />
              </div>
            )}
          </div>
        </div>
      </article>
    )}
  </div>

  <SearchModal client:idle />
  <CartSidebar client:idle />
</DashboardLayout>

<style>
  .tab-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 12px 11px;
    font-size: 14px;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }
  .tab-link:hover { color: var(--color-text-primary); }
  .tab-link[aria-selected='true'] { color: var(--color-text-primary); font-weight: 600; }
  .tab-link[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .tab-count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 18px;
    padding: 0 7px;
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text-secondary);
  }
</style>

<script is:inline>
  (function () {
    // Tabs: #files and #security-scan open their pane, anything else shows Overview.
    var HASH_TO_TAB = { '#files': 'files', '#security-scan': 'security' };
    var TAB_TO_HASH = { overview: '#overview', files: '#files', security: '#security-scan' };

    function show(tab) {
      var panes = document.querySelectorAll('[data-pane]');
      if (!document.querySelector('[data-pane="' + tab + '"]')) tab = 'overview';
      panes.forEach(function (p) { p.hidden = p.getAttribute('data-pane') !== tab; });
      document.querySelectorAll('[data-tab]').forEach(function (t) {
        t.setAttribute('aria-selected', String(t.getAttribute('data-tab') === tab));
      });
    }

    function go(tab, scroll) {
      show(tab);
      try { history.replaceState(null, '', tab === 'overview' ? location.pathname + location.search : TAB_TO_HASH[tab]); } catch (e) {}
      if (scroll) {
        var bar = document.querySelector('[role="tablist"]');
        var top = bar ? bar.getBoundingClientRect().top : 0;
        if (bar && (top < 0 || top > window.innerHeight * 0.6)) bar.scrollIntoView({ block: 'start' });
      }
    }

    show(HASH_TO_TAB[location.hash] || 'overview');
    window.addEventListener('hashchange', function () { show(HASH_TO_TAB[location.hash] || 'overview'); });

    document.querySelectorAll('[data-tab]').forEach(function (t) {
      t.addEventListener('click', function (e) { e.preventDefault(); go(t.getAttribute('data-tab'), false); });
    });
    document.querySelectorAll('[data-tab-link]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); go(a.getAttribute('data-tab-link'), true); });
    });
    // A row of the file list opens that file in the Files tab's explorer.
    document.querySelectorAll('[data-open-file]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        go('files', true);
        window.dispatchEvent(new CustomEvent('component-file:open', { detail: a.getAttribute('data-open-file') }));
      });
    });

    // Copy the install command; fall back to selecting it where the clipboard is refused.
    var btn = document.getElementById('copyBtn');
    if (btn) {
      btn.addEventListener('click', function () {
        var cmd = btn.getAttribute('data-cmd') || '';
        var label = btn.querySelector('span');
        var copyIcon = btn.querySelector('[data-copy-icon]');
        var doneIcon = btn.querySelector('[data-done-icon]');
        var done = function () {
          if (label) label.textContent = 'Copied';
          if (copyIcon) copyIcon.style.display = 'none';
          if (doneIcon) doneIcon.style.display = '';
          setTimeout(function () {
            if (label) label.textContent = 'Copy';
            if (copyIcon) copyIcon.style.display = '';
            if (doneIcon) doneIcon.style.display = 'none';
          }, 2000);
        };
        var select = function () {
          var code = btn.parentElement && btn.parentElement.querySelector('code');
          if (!code) return;
          var range = document.createRange();
          range.selectNodeContents(code);
          var sel = window.getSelection();
          if (sel) { sel.removeAllRanges(); sel.addRange(range); }
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(cmd).then(done, select);
        } else {
          select();
        }
      });
    }
  })();
</script>
