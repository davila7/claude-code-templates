---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TopBar from '../../components/TopBar.astro';

export const prerender = true;

import fs from 'node:fs';
import nodePath from 'node:path';

// Registry generated by scripts/build_agent_plugins.js --publish
const filePath = nodePath.join(process.cwd(), 'public', 'agent-plugins', 'index.json');
let registry: any = { bundles: [] };
try {
  registry = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
} catch { /* empty registry renders an empty state */ }
const bundles: any[] = registry.bundles || [];

function formatSize(bytes: number): string {
  if (!bytes) return '0 B';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<DashboardLayout
  title="Agent Plugins — Open Standard Bundles for Any AI Client"
  description="Portable Agent Plugins (agent-plugins.org) bundles built from aitmpl.com components. Skills and MCP servers work in any conforming client; Claude Code gets the full pack."
>
  <TopBar />

  <!-- Page Header -->
  <div class="relative overflow-hidden border-b border-[var(--color-border)] bg-gradient-to-b from-[var(--color-surface-0)] to-[var(--color-surface-1)]">
    <div class="relative px-6 py-12 max-w-7xl mx-auto">
      <div class="flex items-center gap-6">
        <div
          class="w-20 h-20 rounded-2xl flex items-center justify-center shrink-0 shadow-2xl"
          style="background: linear-gradient(135deg, #34d39920 0%, #34d39910 100%); border: 2px solid #34d39930;"
        >
          <svg class="w-10 h-10" style="color: #34d399" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>

        <div class="flex-1">
          <h1 class="text-3xl font-bold text-[var(--color-text-primary)] mb-2 tracking-tight">
            Agent Plugins <span class="text-[15px] font-medium text-[var(--color-text-tertiary)]">open standard</span>
          </h1>
          <p class="text-[15px] text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
            Portable bundles following the <a href="https://agent-plugins.org" target="_blank" rel="noopener" class="underline hover:text-[var(--color-text-primary)]">agent-plugins.org</a> v1.0.0 spec
            (Amazon, Cursor, Microsoft, OpenAI, Vercel). Skills and MCP servers load in any conforming client — Claude Code gets the full pack including agents, commands and loops.
          </p>
        </div>

        <div class="hidden md:flex items-center gap-2 text-[13px] text-[var(--color-text-tertiary)]">
          <span class="px-3 py-1.5 rounded-full bg-[var(--color-surface-3)] border border-[var(--color-border)]">
            {bundles.length} bundles · spec v{registry.specVersion || '1.0.0'}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bundles grid -->
  <div class="px-6 py-10 max-w-7xl mx-auto">
    {bundles.length === 0 ? (
      <p class="text-[var(--color-text-secondary)]">No bundles published yet.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {bundles.map((bundle: any) => (
          <a
            href={`/agent-plugins/${bundle.name}`}
            class="block rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-1)] p-5 hover:border-[#34d39960] transition-colors"
          >
            <div class="flex items-start justify-between gap-3 mb-2">
              <h2 class="text-lg font-semibold text-[var(--color-text-primary)]">{bundle.name}</h2>
              <span class="text-[12px] text-[var(--color-text-tertiary)] shrink-0">v{bundle.version}</span>
            </div>
            <p class="text-[14px] text-[var(--color-text-secondary)] leading-relaxed mb-4">{bundle.description}</p>
            <div class="flex flex-wrap items-center gap-2">
              {Object.entries(bundle.contents || {}).map(([type, count]) => (
                <span class="px-2 py-0.5 rounded-full text-[12px] bg-[var(--color-surface-3)] border border-[var(--color-border)] text-[var(--color-text-secondary)]">
                  {count} {type}
                </span>
              ))}
              <span class="ml-auto text-[12px] text-[var(--color-text-tertiary)]">
                {bundle.fileCount} files · {formatSize(bundle.totalSize)}
              </span>
            </div>
          </a>
        ))}
      </div>
    )}

    <div class="mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-1)] p-5">
      <h3 class="text-[14px] font-semibold text-[var(--color-text-primary)] mb-2">Machine-readable registry</h3>
      <p class="text-[13px] text-[var(--color-text-secondary)] leading-relaxed">
        The full registry is served at
        <code class="px-1.5 py-0.5 rounded bg-[var(--color-surface-3)] text-[12px]">/agent-plugins/index.json</code>
        with per-bundle <code class="px-1.5 py-0.5 rounded bg-[var(--color-surface-3)] text-[12px]">files.json</code> sha256 manifests —
        CORS-open so any Agent Plugins client can fetch bundles directly. The v1.0.0 spec defines no registry format; this index is the aitmpl.com format, versioned via <code class="px-1.5 py-0.5 rounded bg-[var(--color-surface-3)] text-[12px]">registryVersion</code>.
      </p>
    </div>
  </div>
</DashboardLayout>
