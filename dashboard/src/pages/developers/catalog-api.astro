---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TopBar from '../../components/TopBar.astro';
import ProsePage from '../../components/ProsePage.astro';
import SearchModal from '../../components/SearchModal.tsx';
// Generated by scripts/generate_components_json.py from scripts/catalog_api_v1.schema.json;
// the fields table below is built from it so the page and the schema cannot drift.
import schema from '../../../public/api/v1/schema.json';

export const prerender = true;

const CHANGELOG = 'https://github.com/davila7/claude-code-templates/blob/main/docs/catalog-api/CHANGELOG.md';

type Prop = { type?: string | string[]; $ref?: string; description?: string; enum?: string[] };

function typeOf(p: Prop): string {
  if (p.$ref) return (schema.$defs as Record<string, { type?: string }>)[p.$ref.split('/').pop()!]?.type ?? 'string';
  return Array.isArray(p.type) ? p.type.join(' | ') : (p.type ?? '');
}

function describe(p: Prop): string {
  if (p.description) return p.description;
  if (p.$ref) return (schema.$defs as Record<string, { description?: string }>)[p.$ref.split('/').pop()!]?.description ?? '';
  return '';
}

const componentProps = schema.$defs.component.properties as Record<string, Prop & { properties?: Record<string, Prop> }>;
const fields: { name: string; type: string; description: string }[] = [];
for (const [name, p] of Object.entries(componentProps)) {
  fields.push({ name, type: typeOf(p), description: describe(p) });
  for (const [sub, sp] of Object.entries(p.properties ?? {})) {
    fields.push({ name: `${name}.${sub}`, type: typeOf(sp), description: describe(sp) });
  }
}

const example = `{
  "schemaVersion": "1.0.0",
  "generatedAt": "2026-10-21T03:13:53Z",
  "source": "https://github.com/davila7/claude-code-templates",
  "docs": "https://www.aitmpl.com/developers/catalog-api",
  "count": 1,
  "components": [
    {
      "id": "agents/development-team/frontend-developer",
      "type": "agents",
      "name": "frontend-developer",
      "category": "development-team",
      "path": "development-team/frontend-developer.md",
      "description": "Frontend development specialist for React applications ...",
      "author": null,
      "repo": null,
      "version": null,
      "license": null,
      "keywords": [],
      "downloads": 1234,
      "install": {
        "command": "npx claude-code-templates@latest --agent development-team/frontend-developer",
        "args": ["--agent", "development-team/frontend-developer"]
      },
      "urls": {
        "page": "https://www.aitmpl.com/component/agents/development-team/frontend-developer",
        "source": "https://github.com/davila7/claude-code-templates/blob/main/cli-tool/components/agents/development-team/frontend-developer.md",
        "content": "https://www.aitmpl.com/component-content/agents/development-team/frontend-developer.json"
      },
      "files": null,
      "scan": { "tool": "skillspector", "toolVersion": "2.12.0", "severity": "LOW", "score": 0, "scannedAt": "2026-10-17T20:36:45Z" }
    }
  ]
}`;

const polling = `# 1. Cheap check (under 1 KB)
curl -s https://www.aitmpl.com/api/v1/version.json

# 2. Download the catalog only when sha256 changed since your last run
curl -s https://www.aitmpl.com/api/v1/catalog.json -o catalog.json

# Or one type, with a conditional request
curl -s -H 'If-None-Match: "<etag from the last response>"' \\
  https://www.aitmpl.com/api/v1/catalog/skills.json`;
---

<DashboardLayout
  title="Catalog API | aitmpl.com"
  description="The aitmpl.com catalog of Claude Code components as a versioned JSON API: endpoints, JSON Schema, fields, update cadence and stability policy."
>
  <TopBar />
  <ProsePage heading="Catalog API v1">
    <p>
      The whole aitmpl.com catalog of Claude Code components (agents, commands, MCPs, settings, hooks, skills, loops and
      mods) as static JSON with a published schema. No key, no sign-up, CORS open. Use it from scripts, indexers, editor
      extensions, mods or agents. This is the only part of the site's data with a stability promise: other JSON files the
      site serves (<code>/components.json</code>, <code>/components/&#123;type&#125;.json</code>, <code>/counts.json</code>,
      <code>/search-index.json</code>, and <code>docs/components.json</code> on GitHub) are internal to the site and may
      change without notice.
    </p>

    <h2>Endpoints</h2>
    <ul>
      <li><a href="/api/v1/catalog.json"><code>/api/v1/catalog.json</code></a>: every component (about 2.8 MB, about 440 KB compressed).</li>
      <li><code>/api/v1/catalog/&#123;type&#125;.json</code>: one type, with the same envelope. <code>type</code> is one of <code>agents</code>, <code>commands</code>, <code>mcps</code>, <code>settings</code>, <code>hooks</code>, <code>skills</code>, <code>loops</code>, <code>mods</code>.</li>
      <li><a href="/api/v1/version.json"><code>/api/v1/version.json</code></a>: <code>schemaVersion</code>, <code>generatedAt</code>, <code>sha256</code> of <code>catalog.json</code> and counts per type. Poll this one.</li>
      <li><a href="/api/v1/schema.json"><code>/api/v1/schema.json</code></a>: JSON Schema (draft 2020-12) for all of the above.</li>
    </ul>
    <p>
      Every response is <code>application/json; charset=utf-8</code> with <code>Access-Control-Allow-Origin: *</code>,
      <code>Cache-Control: public, max-age=300, stale-while-revalidate=3600</code> and an <code>ETag</code> (send it back
      as <code>If-None-Match</code> to get a 304).
    </p>

    <h2>Polling</h2>
    <pre class="overflow-x-auto rounded-md bg-[var(--color-surface-1)] p-3 text-[12px]"><code>{polling}</code></pre>

    <h2>Update cadence</h2>
    <p>
      The catalog is regenerated whenever a component is added or changed (several times a day on busy days) and once a day
      after 03:00 UTC, when download counts are refreshed. <code>generatedAt</code> only moves when a component's data
      actually changed. Polling more often than every 5 minutes gains nothing.
    </p>

    <h2>Minimal example</h2>
    <pre class="overflow-x-auto rounded-md bg-[var(--color-surface-1)] p-3 text-[12px]"><code>{example}</code></pre>

    <h2>Fields</h2>
    <p>
      Every field below is present on every component. A value that is unknown is <code>null</code>, never missing and
      never an empty string. <code>components</code> is sorted by <code>id</code>. Use <code>id</code> as the key:
      <code>name</code> alone repeats across categories.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-[12px] border-collapse">
        <thead>
          <tr class="border-b border-[var(--color-border)] text-[var(--color-text-primary)]">
            <th class="py-2 pr-4 font-semibold">Field</th>
            <th class="py-2 pr-4 font-semibold">Type</th>
            <th class="py-2 font-semibold">Meaning</th>
          </tr>
        </thead>
        <tbody>
          {fields.map((f) => (
            <tr class="border-b border-[var(--color-border)] align-top">
              <td class="py-2 pr-4"><code>{f.name}</code></td>
              <td class="py-2 pr-4 whitespace-nowrap"><code>{f.type}</code></td>
              <td class="py-2">{f.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3">
      Not in the catalog: sponsored placements. The catalog never contains placement data, and its order never depends on
      downloads, sponsorship or anything but <code>id</code>.
    </p>

    <h2>Stability policy</h2>
    <ul>
      <li><code>schemaVersion</code> follows semantic versioning. Everything under <code>/api/v1/</code> is major version 1.</li>
      <li>Within major version 1, changes are additive only: new optional fields, new <code>type</code> values, new enum values, new files. Ignore fields and types you do not know.</li>
      <li>A breaking change (removing or renaming a field, changing a type or the <code>id</code> format, removing a URL) ships only as a new major version at a new path (<code>/api/v2/</code>). The previous major keeps being published for at least 6 months after that, with a <code>Deprecation</code> header and a changelog entry on the first day.</li>
      <li>An <code>id</code> is permanent for its component. A moved or renamed component appears under a new <code>id</code>; removing a component is not a breaking change.</li>
      <li><code>downloads</code> and <code>scan</code> values change daily; their meaning does not. <code>scan</code> is a static-analysis hint, not a security verdict: read a component before installing it, especially hooks, MCP servers and mods, which run code on your machine.</li>
      <li><code>urls.content</code> files are linked for convenience; their format is not yet part of this contract.</li>
    </ul>

    <h2>Changelog</h2>
    <p>
      Format changes are recorded in the <a href={CHANGELOG}>catalog API changelog</a>, separate from the CLI's release
      notes. Watch that file to hear about new fields before they ship.
    </p>

    <h2>Contact</h2>
    <p>
      If you build on this API, a <code>User-Agent</code> header with a URL or contact helps us reach you before a change.
      Questions and requests go to <a href="https://github.com/davila7/claude-code-templates/issues">GitHub issues</a>.
      The site's agent-oriented overview is <a href="/llms.txt">/llms.txt</a>, and <a href="/openapi.json">/openapi.json</a>
      describes the same endpoints for OpenAPI tooling.
    </p>
  </ProsePage>
  <SearchModal client:idle />
</DashboardLayout>
